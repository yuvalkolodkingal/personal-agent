{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-agent.dev/schema/skill/v1",
  "title": "Personal Agent skill metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "scopes"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "description": { "type": "string", "minLength": 1 },
    "scopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "requires": {
      "type": "object",
      "properties": {
        "platforms": { "type": "array", "items": { "enum": ["windows", "macos", "linux"] } },
        "binaries": { "type": "array", "items": { "type": "string" } },
        "configuration": { "type": "array", "items": { "type": "string" } }
      }
    },
    "body": { "type": "string" },
    "tests": { "type": "array", "items": { "type": "string" } }
  }
}
