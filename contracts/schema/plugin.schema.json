{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-agent.dev/schema/plugin/v1",
  "title": "Personal Agent plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "publisher", "runtime", "scopes", "signature"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "publisher": { "type": "string", "minLength": 1 },
    "runtime": { "enum": ["declarative", "wasi", "process"] },
    "entrypoint": { "type": "string" },
    "scopes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "type": "string" },
        "value": { "type": "string", "contentEncoding": "base64" }
      }
    },
    "ui": { "type": "array", "items": { "type": "object" }, "default": [] }
  }
}
