diff --git a/packages/opencode/src/session/environment.ts b/packages/opencode/src/session/environment.ts
new file mode 100644
index 0000000..d615626
--- /dev/null
+++ b/packages/opencode/src/session/environment.ts
@@ -0,0 +1,19 @@
+import type { SessionID } from "./schema"
+
+const entries = new Map<SessionID, Record<string, string>>()
+
+export const SessionEnvironment = {
+  set(sessionID: SessionID, environment?: Record<string, string>) {
+    if (!environment || Object.keys(environment).length === 0) {
+      entries.delete(sessionID)
+      return
+    }
+    entries.set(sessionID, { ...environment })
+  },
+  get(sessionID: SessionID) {
+    return { ...entries.get(sessionID) }
+  },
+  remove(sessionID: SessionID) {
+    entries.delete(sessionID)
+  },
+}
